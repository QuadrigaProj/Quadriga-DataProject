# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# .env 는 절대 Git에 커밋하지 않습니다. (.gitignore 에 등록돼 있음)

# 공공데이터포털 일반 인증키 (Encoding)
# 발급: https://www.data.go.kr/iim/api/selectAcountList.do
#       → 측정결과 정보 클릭 → "일반 인증키" 복사
DATA_GO_KR_KEY=your_key_here

# 데이터 경로 (기본값 그대로 두면 됩니다)
DATA_DIR=./data/raw

# ===== 소셜 로그인 (선택) =====
# 각 개발자 콘솔에서 앱을 만들고 발급받은 값을 넣으세요.
# 비워두면 해당 버튼이 비활성으로 표시되고, 이메일 가입만 동작합니다.
# 리디렉션 URI 는 http://localhost:8000/auth/<제공자>/callback 로 등록합니다.
#
# 요청 권한은 최소한만 씁니다 (이메일·닉네임).
# 휴대폰 번호·생일 같은 항목은 신청하지 마세요. 받아도 서버에서 버립니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# KAKAO_CLIENT_ID(REST 키)는 홈 화면 경로 분석(/route/advice · 카카오 장소 검색·도보 경로)에도 쓰입니다. 없으면 직선거리 추정으로 동작합니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ===== 이용권 결제 · 카카오페이 (선택) =====
# 넣으면 이용권 충전에서 '카카오페이' 를 고를 수 있습니다.
# 비워두면 그 버튼만 잠기고, 카드·계좌이체는 모의 승인으로 그대로 동작합니다.
#
# 발급: https://developers.kakao.com 에서 앱 생성 → 카카오페이 신청
#       개발용 SECRET KEY 는 DEV 로 시작합니다.
#
# KAKAOPAY_CID 는 가맹점 코드입니다.
#   TC0ONETIME  = 카카오가 주는 테스트 코드. 결제창은 진짜지만 돈이 안 빠집니다.
#   실제 코드   = 가맹점 계약 후 발급받은 값. **진짜 돈이 빠집니다.**
# 바꾸면 화면 안내 문구도 "실제로 결제됩니다" 로 바뀝니다.
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID=TC0ONETIME

# 결제 후 카카오가 사용자를 돌려보낼 주소. 배포 주소와 정확히 같아야 합니다.
# (없으면 요청 헤더로 추정하는데, 프록시 뒤에서는 어긋날 수 있습니다)
PUBLIC_BASE_URL=

# ===== AI 루틴 추천 (선택) =====
# 넣으면 '루틴 추천' 이 후보 순서와 설명을 Claude 로 다듬습니다.
# 비워두면 지금까지처럼 점수만으로 추천합니다 (기능은 그대로 동작).
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
